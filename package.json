{
  "name": "jndsystem-kr",
  "version": "0.1.0",
  "private": true,
  "description": "제이앤디시스템 공식 사이트 (https://jndsystem.kr/) — A v4 디자인 구현, 승인 기반 발행, 검색 검증 도구",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prebuild": "node scripts/validate-registry.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "registry:import": "python3 -I scripts/import-xlsx.py",
    "registry:validate": "node scripts/validate-registry.mjs",
    "registry:export": "node scripts/export-csv.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "content:dupcheck": "node scripts/dup-check.mjs",
    "parity:shots": "node scripts/parity-shots.mjs",
    "parity:diff": "node scripts/parity-diff.mjs",
    "content:audit": "node scripts/content-audit.mjs",
    "content:lastmod": "node scripts/content-lastmod.mjs",
    "intent:audit": "node scripts/intent-audit.mjs",
    "ledger:upgrade": "node scripts/ledger-upgrade.mjs",
    "mobile:check": "node scripts/mobile-check.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "search:dashboard": "node scripts/search-dashboard.mjs",
    "qa": "npm run registry:validate && npm run typecheck && npm run lint && npm test && npm run seo:audit && npm run content:dupcheck && npm run content:audit && npm run mobile:check"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.7",
    "lucide-static": "0.460.0",
    "next": "16.4.5",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "undici": "7.30.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  }
}
