# ── 운영 호스트 (고정) ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://jndsystem.kr

# ── 공개 콘텐츠 게이트 ─────────────────────────────────────────
# strict  : data/registry/publication-ledger.json 에서 status=published(approved→배포 시 published) 인 항목만 공개 빌드에 포함 (운영 기본)
# preview : 시안(A v4)에 포함된 자료를 모두 표시 — 디자인 대조·내부 QA 전용. 운영 배포 금지
CONTENT_GATE=strict

# ── 문의 접수 ──────────────────────────────────────────────────
# test  : 접수를 저장하되 "테스트 접수" 안내를 표시하고 운영 알림을 보내지 않음 (실연동 전 기본)
# live  : 운영 알림(아래 설정) 사용
CONTACT_MODE=test
# 저장소: 운영 Netlify Blobs(자동), 로컬 비공개 파일(JND_DATA_DIR) | memory(로컬 테스트 전용)
CONTACT_STORE=file
# 운영: netlify-forms + Netlify Forms > Submission notifications에서 수신 이메일 등록·확인
# 웹훅을 사용할 때는 CONTACT_NOTIFY_PROVIDER를 비우고 CONTACT_NOTIFY_WEBHOOK 설정
CONTACT_NOTIFY_PROVIDER=
CONTACT_NOTIFY_WEBHOOK=
CONTACT_NOTIFY_EMAIL=
# 사진 첨부 허용 여부·장당 용량(MB)·최대 장수·보관일 — 운영자 승인 전 비활성
CONTACT_ATTACHMENTS=off
CONTACT_ATTACH_MAX_MB=10
CONTACT_ATTACH_MAX_COUNT=5
CONTACT_ATTACH_RETENTION_DAYS=30

# ── 관리자 (서버 인증) ──────────────────────────────────────────
# 비밀번호는 평문을 넣지 않는다. 해시 생성: node scripts/admin-hash.mjs '<password>'
ADMIN_USERS=owner:owner@example.com:<scrypt-hash>:admin,staff:staff@example.com:<scrypt-hash>:editor
# 세션 서명 비밀키 (32바이트 이상 랜덤): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ── 검색 콘솔 소유 확인 (운영자 계정에서 발급받은 값만) ───────────
NAVER_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
# IndexNow 사용 시 키(공개 키 파일 /indexnow/{key}.txt 로 제공, scripts/indexnow.mjs)
INDEXNOW_KEY=

# ── 운영자 페이지 작성(관리자 → 새 페이지 작성) ──────────────────
# 콘텐츠 저장소: var/content/pages.json (단일 서버 기본). 서버리스는 DB 어댑터 필요(docs/release-and-rollback.md)
# 사진 업로드 한도: 장당 MB, 최대 픽셀 수. 원본 var/uploads/orig(비공개), 공개 WebP var/uploads/web → /uploads/{id}-{w}.webp
UPLOAD_MAX_MB=15
UPLOAD_MAX_PIXELS=40000000
